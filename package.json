{
  "name": "monstats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "npm run build:workers && next dev --hostname 127.0.0.1",
    "build": "next build && npm run build:workers",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/seed-test.ts && playwright test",
    "assets:cache": "node dist/workers/sprites.mjs",
    "format:check": "prettier --check src scripts tests config *.json *.ts *.mjs README.md docs/*.md",
    "audit:source": "tsx scripts/audit.ts",
    "audit:sources": "tsx scripts/audit-sources.ts",
    "audit:official": "tsx scripts/audit-official.ts",
    "ingest": "node dist/workers/ingest.mjs",
    "ingest:watch": "node dist/workers/daily.mjs",
    "ingest:ladder": "node dist/workers/ingest-ladder.mjs",
    "ingest:ladder:watch": "node dist/workers/ladder-worker.mjs",
    "regulation:activate": "node dist/workers/activate.mjs",
    "trace": "tsx scripts/trace.ts",
    "matchups:backfill": "tsx scripts/backfill-matchups.ts",
    "evidence:backfill": "tsx scripts/backfill-evidence.ts",
    "matchups:benchmark": "tsx scripts/benchmark-matchups.ts",
    "build:workers": "node scripts/build-workers.mjs",
    "ingest:daily": "node dist/workers/daily.mjs --once",
    "operations": "node dist/workers/operations.mjs",
    "regulation:backfill": "node dist/workers/backfill-regulation.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "8.2.0",
    "@pkmn/dex": "^0.10.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
